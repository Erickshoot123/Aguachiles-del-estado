PORT=4000

# Impresoras disponibles en esta terminal (arreglo JSON). Cada una tiene:
# - id: identificador que el frontend usa para elegirla (guardado en
#   localStorage del navegador, por terminal).
# - name: nombre mostrado al cajero.
# - interface: destino ESC/POS.
#   - Sin impresora física (desarrollo/pruebas): una ruta de archivo local;
#     cada ticket se escribe ahí en formato ESC/POS crudo.
#   - Impresora de red real: tcp://<ip>:9100
#   - Impresora instalada en el sistema (Windows/Linux, requiere el paquete
#     de driver correspondiente): printer:<nombre>
PRINTERS=[{"id":"default","name":"Impresora principal","interface":"./print-output/last-ticket.bin"}]

# Ancho en caracteres por línea según el formato del ticket elegido.
PRINTER_WIDTH_58=32
PRINTER_WIDTH_80=42
