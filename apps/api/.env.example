NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aguachiles_pos
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
# Máximo de intentos de login por IP dentro de la ventana antes de responder 429.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=60000
